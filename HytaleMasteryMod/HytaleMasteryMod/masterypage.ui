Group {
    Anchor:  (Width:  450, Height: 350);
    Background: #1a1a2e(0.95);
    LayoutMode: Top;
    Padding: (Full: 25);

    Label #Title {
        Text: "SWORD MASTERY";
        Anchor: (Height: 45);
        Style: (
            FontSize: 28,
            TextColor: #ffffff,
            RenderBold: true,
            Alignment: Center,
            LetterSpacing: 2
        );
    }

    Group {
        Anchor: (Height: 2);
        Background: #4a9eff;
    }

    Group { Anchor: (Height: 20); }

    Group #StatsContainer {
        LayoutMode: Top;
        Anchor: (Height: 180);
        Padding: (Full: 10);
        Background: #0f0f1e(0.8);

        Label #LevelText {
            Text:  "Level:  1";
            Anchor: (Height: 40);
            Style: (
                FontSize: 22,
                TextColor: #4a9eff,
                RenderBold: true
            );
        }

        Group { Anchor: (Height: 10); }

        Label #ExpText {
            Text: "Exp: 0 / 100";
            Anchor: (Height: 30);
            Style: (
                FontSize: 18,
                TextColor: #96a9be
            );
        }

        Group { Anchor: (Height: 10); }

        Label #DamageText {
            Text:  "Sword Damage: +0";
            Anchor: (Height: 30);
            Style:  (
                FontSize: 18,
                TextColor: #96a9be
            );
        }
    }

    Group { Anchor: (Height: 15); }

    Label {
        Text: "BONUSES";
        Anchor: (Height: 25);
        Style: (
            FontSize: 12,
            TextColor: #6e7da1,
            RenderUppercase: true,
            LetterSpacing: 2
        );
    }

    Group { Anchor: (Height: 8); }

    Group #BonusContainer {
        LayoutMode: Top;
        Padding: (Full: 10);
        Background: #0f0f1e(0.6);

        Label #BonusStatus {
            Text: "Level 2: +5 Flat Damage";
            Anchor:  (Height: 30);
            Style: (
                FontSize: 16,
                TextColor: #96a9be
            );
        }
    }

    Group { Anchor: (Height: 10); }

    Label #HelpText {
        Text: "Hit enemies with swords to gain experience!";
        Anchor: (Height: 25);
        Style: (
            FontSize: 12,
            TextColor: #6e7da1,
            Alignment: Center
        );
    }
}